; Clarus India firm chart of accounts (v1)
; Entity: sole proprietorship (default). Adjust names for partnership / company.
; Currency: INR (see commodities.journal)
;
; Account types:
;   ASSETS       — bank, cash, receivables, GST input, fixed assets, deposits
;   LIABILITIES  — payables, GST output, TDS, loans, provisions
;   EQUITY       — capital, drawings, opening balances
;   INCOME       — sales / professional fees / other inflows
;   EXPENSES     — purchases, operating costs, finance, taxes

; ====================================================================
; ASSETS
; ====================================================================

account assets:bank:current
account assets:bank:savings
account assets:cash
account assets:receivables:trade
account assets:receivables:other
account assets:inventory
account assets:gst:input-cgst
account assets:gst:input-sgst
account assets:gst:input-igst
account assets:deposits
account assets:prepaid
account assets:fixed-assets:plant-and-machinery
account assets:fixed-assets:furniture-and-fixtures
account assets:fixed-assets:vehicles
account assets:fixed-assets:computers
account assets:fixed-assets:other

; ====================================================================
; LIABILITIES
; ====================================================================

account liabilities:payables:trade
account liabilities:payables:other
account liabilities:gst:output-cgst
account liabilities:gst:output-sgst
account liabilities:gst:output-igst
account liabilities:gst:payable
account liabilities:tds-payable
account liabilities:loans:bank
account liabilities:loans:other
account liabilities:provisions
account liabilities:salary-payable

; ====================================================================
; EQUITY — sole prop capital / drawings
; ====================================================================

account equity:capital
account equity:drawings
account equity:opening-balances

; ====================================================================
; INCOME
; ====================================================================

account income:sales:taxable
account income:sales:exempt
account income:sales:exports
account income:professional-fees
account income:interest
account income:other

; ====================================================================
; EXPENSES
; ====================================================================

account expenses:purchases:taxable
account expenses:purchases:exempt
account expenses:salaries-and-wages
account expenses:rent
account expenses:utilities:electricity
account expenses:utilities:internet
account expenses:utilities:phone
account expenses:utilities:other
